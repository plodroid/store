{
  "appId": "com.plodroid.beehive.owner",
  "appName": "Bee Hive Owner",
  "webDir": "www",
  "server": {
    "url": "https://plodroid.github.io/store/admin/",
    "errorPath": "error.html",
    "allowNavigation": ["plodroid.github.io", "script.google.com", "script.googleusercontent.com", "*.googleapis.com", "*.firebaseapp.com"]
  },
  "android": { "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#F4F3EE", "showSpinner": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#F4F3EE", "overlaysWebView": false },
    "FirebaseAuthentication": { "skipNativeAuth": true, "providers": ["google.com"] }
  }
}
